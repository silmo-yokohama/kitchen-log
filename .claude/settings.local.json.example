{
  "permissions": {
    "allow": [
      "Write(/viewer/**)",
      "Edit(/viewer/**)",
      "Edit(/docs/workflows/**)",
      "Bash(npm install --prefix viewer)",
      "Bash(npm run dev --prefix viewer)",
      "Bash(npm run build --prefix viewer)",
      "Bash(npm run test --prefix viewer)",
      "Bash(npx astro check)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr merge *)"
    ]
  }
}
